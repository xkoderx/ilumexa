<!-- Logotipo en texto: el banner oficial (logo.jpg) se quitó del
     header a petición de Patron (2026-11-07): no se veía como el logo
     de la página. La imagen sigue en public/images por si se usa en
     otro lado, y el footer aún la muestra. -->
<header class="sticky top-0 z-50 border-b border-royal-100 bg-white/95 shadow-sm backdrop-blur dark:border-slate-800 dark:bg-royal-950/95">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Ilumexa - Inicio">
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-royal-700 text-xl font-extrabold text-white shadow-sm">I</span>
      <span class="leading-none">
        <span class="block text-2xl font-extrabold tracking-tight text-royal-900 dark:text-white">Ilumexa</span>
        <span class="mt-1 block text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-green-600 dark:text-brand-green-400">Iluminando a México</span>
      </span>
    </a>
    <div class="hidden items-center gap-1 text-sm font-medium text-slate-700 dark:text-slate-200 md:flex">
      <a href="/" class="rounded-full px-3 py-2 transition hover:bg-royal-50 hover:text-royal-800 dark:hover:bg-royal-900 dark:hover:text-white">Inicio</a>
      <a href="/about" class="rounded-full px-3 py-2 transition hover:bg-royal-50 hover:text-royal-800 dark:hover:bg-royal-900 dark:hover:text-white">Acerca de</a>
      <a href="/products" class="rounded-full px-3 py-2 transition hover:bg-royal-50 hover:text-royal-800 dark:hover:bg-royal-900 dark:hover:text-white">Productos</a>
      <a href="/services" class="rounded-full px-3 py-2 transition hover:bg-royal-50 hover:text-royal-800 dark:hover:bg-royal-900 dark:hover:text-white">Servicios</a>
      <a href="/contact" class="rounded-full bg-royal-700 px-4 py-2 text-white shadow-sm transition hover:bg-royal-800">Contacto</a>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 text-sm font-medium text-slate-700 dark:text-slate-200 md:hidden">
        <a href="/products" class="rounded-full px-2 py-2 hover:text-royal-700">Productos</a>
        <a href="/contact" class="rounded-full px-2 py-2 hover:text-royal-700">Contacto</a>
      </div>
      <!-- Botón de tema -->
      <button
        id="theme-toggle"
        aria-label="Cambiar entre modo claro y oscuro"
        class="rounded-full border border-slate-200 bg-white px-3 py-2 text-sm shadow-sm transition hover:border-royal-300 hover:text-royal-700 dark:border-slate-700 dark:bg-slate-800 dark:hover:text-brand-green-300"
      >
        🌞 / 🌙
      </button>
    </div>
  </nav>
  <!-- Navegación secundaria en móvil -->
  <div class="flex items-center gap-1 overflow-x-auto border-t border-slate-100 px-4 py-2 text-sm font-medium text-slate-600 dark:border-slate-800 dark:text-slate-300 md:hidden">
    <a href="/" class="rounded-full px-3 py-1 hover:text-royal-700">Inicio</a>
    <a href="/about" class="rounded-full px-3 py-1 hover:text-royal-700">Acerca de</a>
    <a href="/services" class="rounded-full px-3 py-1 hover:text-royal-700">Servicios</a>
  </div>
  <script>
    const btn = document.getElementById('theme-toggle');
    btn!.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
    });
  </script>
</header>
