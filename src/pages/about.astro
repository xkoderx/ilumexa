---
import Layout from '../layouts/Layout.astro';

const providers = [
  'TORK',
  'OSRAM',
  'LUMICOM',
  'SOLA BASIC',
  'Philips',
  'AMG',
  'MAGG',
  'TECNO LIGHT',
  'LEXALITE',
  'FORLIGHTING',
];

const advantages = [
  {
    title: 'Asesoramiento en proyectos',
    text: 'Asesoramiento en el desarrollo de sus proyectos.',
  },
  {
    title: 'Bajos costos',
    text: 'Bajos costos en suministros.',
  },
  {
    title: 'Mantenimiento garantizado',
    text: 'Garantía de bajos costos de mantenimiento.',
  },
  {
    title: 'Ahorro de energía',
    text: 'Modernos sistemas de ahorro de energía.',
  },
];

const areas = [
  'Alumbrado público',
  'Iluminación industrial',
  'Iluminación residencial y decorativa',
];
---

<Layout title="Acerca de Ilumexa">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <!-- Banda de encabezado: texto blanco solo sobre degradado azul rey -->
    <div class="rounded-3xl bg-gradient-to-r from-royal-900 via-royal-800 to-royal-700 px-6 py-10 text-white shadow-lg sm:px-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-300">
        ¿Quiénes somos?
      </p>
      <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight md:text-4xl">
        Iluminación con calidad, durabilidad y ahorro de energía
      </h2>
      <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-royal-100">
        <p>
          Ilumexa es una empresa dedicada a la fabricación y comercialización
          de productos para alumbrado público, industrial, residencial y
          decorativo, así como a la comercialización de accesorios eléctricos.
        </p>
        <p>
          Nuestro compromiso es brindar un servicio de calidad a un precio
          competitivo, con productos durables y de ahorro de energía, que
          además aporten estética tanto en interiores como en exteriores, para
          satisfacer las necesidades de cada cliente según sus requerimientos
          y expectativas.
        </p>
      </div>
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-royal-950 dark:text-white">
      Nuestros proveedores
    </h3>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      Trabajamos con proveedores líderes del mercado:
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        providers.map((provider) => (
          <span class="rounded-full border border-royal-200 bg-white px-4 py-2 text-sm font-semibold tracking-wide text-royal-800 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-brand-green-300">
            {provider}
          </span>
        ))
      }
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-royal-950 dark:text-white">
      Ventajas competitivas
    </h3>
    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {
        advantages.map((advantage, i) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-md transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div class="h-1 w-10 rounded-full bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
            <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-brand-green-600 dark:text-brand-green-400">
              0{i + 1}
            </p>
            <h4 class="mt-1 text-xl font-semibold text-royal-950 dark:text-white">
              {advantage.title}
            </h4>
            <p class="mt-2 text-slate-600 dark:text-slate-400">{advantage.text}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-royal-950 dark:text-white">
      Áreas de iluminación
    </h3>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        areas.map((area) => (
          <div class="rounded-2xl bg-royal-900 p-8 text-white shadow-lg">
            <p class="text-lg font-semibold">{area}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10">
      Conoce más de Ilumexa en video:
      <a
        href="https://youtu.be/eVwipVw4YxI"
        class="font-semibold text-royal-700 hover:underline dark:text-brand-green-300"
      >
        Ver video en YouTube
      </a>
      . También puedes verlo integrado en la
      <a href="/" class="font-semibold text-royal-700 hover:underline dark:text-brand-green-300">
        página de inicio
      </a>.
    </p>
  </div>
</Layout>
