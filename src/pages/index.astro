---
import Layout from '../layouts/Layout.astro';

// Contenido verificado del sitio oficial (iluminandomexico.com.mx).
// Landing de una sola página (2026-11-07): todo el contenido de las
// antiguas páginas Acerca de, Productos, Servicios y Contacto vive aquí
// en secciones con ancla; el header ya no redirecciona a otras páginas.
// Todos los textos de estas secciones son negros u oscuros sobre fondos
// claros (2026-11-07, a petición de Patron): no queda texto blanco
// fuera del hero, donde va sobre la tarjeta oscura de la foto.

const providers = [
  'TORK',
  'OSRAM',
  'LUMICOM',
  'SOLA BASIC',
  'Philips',
  'AMG',
  'MAGG',
  'TECNO LIGHT',
  'LEXALITE',
  'FORLIGHTING',
];

const advantages = [
  {
    title: 'Asesoramiento en proyectos',
    text: 'Asesoramiento en el desarrollo de sus proyectos.',
  },
  {
    title: 'Bajos costos',
    text: 'Bajos costos en suministros.',
  },
  {
    title: 'Mantenimiento garantizado',
    text: 'Garantía de bajos costos de mantenimiento.',
  },
  {
    title: 'Ahorro de energía',
    text: 'Modernos sistemas de ahorro de energía.',
  },
];

const areas = [
  'Alumbrado público',
  'Iluminación industrial',
  'Iluminación residencial y decorativa',
];

const categories = [
  {
    name: 'Alumbrado Público',
    description: 'Soluciones de iluminación para alumbrado público.',
  },
  {
    name: 'Alumbrado Exterior',
    description: 'Iluminación para espacios exteriores.',
  },
  {
    name: 'Iluminación LED',
    description: 'Productos de iluminación LED.',
  },
  {
    name: 'Luminario',
    description: 'Luminarios para distintos espacios y usos.',
  },
  {
    name: 'Postes',
    description: 'Postes para alumbrado.',
  },
  {
    name: 'Alumbrado Decorativo',
    description: 'Iluminación decorativa para distintos espacios.',
  },
  {
    name: 'Alumbrado Industrial',
    description: 'Iluminación para espacios industriales.',
  },
  {
    name: 'Postes - Fichas Técnicas',
    description: 'Fichas técnicas de postes. Detalle pendiente de verificar.',
  },
  {
    name: 'Exterior Decorativo',
    description: 'Iluminación decorativa para exteriores.',
  },
  {
    name: 'Interior Decorativo',
    description: 'Iluminación decorativa para interiores.',
  },
  {
    name: 'Mobiliario Decorativo',
    description: 'Mobiliario decorativo con iluminación.',
  },
  {
    name: 'Accesorios y Bases de Concreto',
    description:
      'Accesorios y bases de concreto para instalaciones de alumbrado.',
  },
];

const services = [
  {
    name: 'Mantenimiento e Instalación',
    description: 'Servicio de mantenimiento e instalación de alumbrado.',
  },
  {
    name: 'Asesoría de Proyectos',
    description: 'Asesoramiento en el desarrollo de sus proyectos.',
  },
];
---

<Layout title="Iluminando México">
  <!-- Hero principal: slider de una sola imagen.
       Foto: carretera con farolas encendidas de noche entre la niebla,
       de Darya Grey_Owl en Pexels (licencia gratuita), 1125x750 px.
       Sustituye a la foto del sitio oficial (images/4a.png, 500x250 px),
       que se veía pixelada a todo el ancho. Es el único slide: no se
       inventaron más fotos ni hay rotación automática. Los textos van
       dentro de una tarjeta azul rey semitransparente con desenfoque,
       en blanco sobre la tarjeta oscura. -->
  <section
    id="inicio"
    class="relative w-full overflow-hidden"
    role="region"
    aria-roledescription="carrusel"
    aria-label="Ilumexa - Iluminando México"
  >
    <div class="relative h-[45vh] min-h-[380px] w-full md:h-[60vh] lg:h-[70vh]">
      <div class="absolute inset-0">
        <img
          src="/images/calle-iluminada.jpg"
          alt="Carretera iluminada de noche con farolas encendidas entre la niebla"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-royal-950/60 via-royal-950/30 to-royal-950/20"></div>
      </div>
      <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center px-4 text-center sm:px-6">
        <!-- Tarjeta sin borde visible y centrada: el texto va centrado
             y la tarjeta queda en el centro del hero. -->
        <div class="max-w-2xl rounded-3xl bg-royal-950/60 p-6 shadow-2xl backdrop-blur-md sm:p-10">
          <p class="mx-auto mb-5 inline-block w-fit rounded-full border border-brand-green-300/50 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-300">
            Iluminando a México e Innovando
          </p>
          <h1 class="max-w-2xl text-5xl font-extrabold leading-tight tracking-tight text-white md:text-6xl">
            Ilumexa
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white md:text-xl">
            Soluciones de iluminación pública, industrial, residencial y
            decorativa con marcas líderes.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a
              href="#productos"
              class="rounded-full bg-white px-7 py-3 text-center font-semibold text-royal-800 shadow-lg transition hover:bg-brand-green-100"
            >
              Ver productos
            </a>
            <a
              href="#contacto"
              class="rounded-full border border-white/60 px-7 py-3 text-center font-semibold text-white transition hover:bg-white/10"
            >
              Contáctanos
            </a>
          </div>
        </div>
        <!-- Ventajas en el hero: afirmaciones verificadas del sitio oficial -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
            Asesoría de proyectos
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
            Ahorro de energía
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Marcas líderes
          </span>
        </div>
      </div>
      <!-- Indicador del slider (un solo slide) -->
      <div class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 gap-2" aria-hidden="true">
        <span class="h-2 w-8 rounded-full bg-brand-green-400"></span>
      </div>
      <!-- Crédito de la foto del hero -->
      <p class="absolute bottom-5 right-4 z-10 hidden text-[11px] text-white/70 sm:block">
        Foto:
        <a href="https://www.pexels.com/photo/lighted-street-lights-between-a-highway-12348285/" class="underline hover:text-white" target="_blank" rel="noopener">Darya Grey_Owl / Pexels</a>
      </p>
    </div>
  </section>

  <!-- Video de Ilumexa: banda blanca sobre el fondo azul claro -->
  <section class="border-b border-royal-100 bg-white">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 md:py-24">
      <p class="mb-2 text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        Conoce Ilumexa
      </p>
      <h2 class="text-center text-3xl font-bold tracking-tight text-black md:text-4xl">
        Ilumexa en video
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <div class="mt-8 overflow-hidden rounded-2xl shadow-xl ring-1 ring-slate-200">
        <iframe
          src="https://www.youtube.com/embed/eVwipVw4YxI"
          title="Video de Ilumexa"
          class="aspect-video w-full"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Carrusel de logos (duplicado: la segunda copia lleva aria-hidden
       para que la animación animate-scroll, que desplaza -50%, gire sin
       salto. No se cambió el orden ni las imágenes de la primera lista.
       Gira siempre: sin pausa al pasar el mouse, a petición de Patron.) -->
  <section class="border-b border-brand-green-100 bg-brand-green-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="mb-2 text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        Con el respaldo de
      </p>
      <h2 class="text-center text-3xl font-bold tracking-tight text-black">
        Marcas aliadas
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <div class="relative mt-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
        <div class="flex w-max animate-scroll">
          <div class="flex items-center space-x-12 pr-12">
            <img src="/images/tork.png" alt="Tork" class="h-16" />
            <img src="/images/osram.png" alt="OSRAM" class="h-16" />
            <img src="/images/forlexa.jpg" alt="forlexa" class="h-16" />
            <img src="/images/philips.png" alt="Philips" class="h-16" />
            <img src="/images/tecnolight.png" alt="Tecno Light" class="h-16" />
            <img src="/images/amg.png" alt="AMG" class="h-16" />
            <img src="/images/forlighting.png" alt="Forlighting" class="h-16" />
            <img src="/images/luma.jpg" alt="Luma" class="h-16" />
            <img src="/images/lumicom.png" alt="Lumicom" class="h-16" />
            <img src="/images/magg.png" alt="MAGG" class="h-16" />
            <img src="/images/sola-basic.png" alt="Sola Basic" class="h-16" />
          </div>
          <div class="flex items-center space-x-12 pr-12" aria-hidden="true">
            <img src="/images/tork.png" alt="" class="h-16" />
            <img src="/images/osram.png" alt="" class="h-16" />
            <img src="/images/forlexa.jpg" alt="" class="h-16" />
            <img src="/images/philips.png" alt="" class="h-16" />
            <img src="/images/tecnolight.png" alt="" class="h-16" />
            <img src="/images/amg.png" alt="" class="h-16" />
            <img src="/images/forlighting.png" alt="" class="h-16" />
            <img src="/images/luma.jpg" alt="" class="h-16" />
            <img src="/images/lumicom.png" alt="" class="h-16" />
            <img src="/images/magg.png" alt="" class="h-16" />
            <img src="/images/sola-basic.png" alt="" class="h-16" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nosotros (antes /about): textos en negro sobre fondo claro -->
  <section id="nosotros" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
      01 · ¿Quiénes somos?
    </p>
    <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight text-black md:text-4xl">
      Iluminación con calidad, durabilidad y ahorro de energía
    </h2>
    <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>

    <div class="mt-8 max-w-3xl space-y-4 text-lg leading-relaxed text-slate-800">
      <p>
        Ilumexa es una empresa dedicada a la fabricación y comercialización
        de productos para alumbrado público, industrial, residencial y
        decorativo, así como a la comercialización de accesorios eléctricos.
      </p>
      <p>
        Nuestro compromiso es brindar un servicio de calidad a un precio
        competitivo, con productos durables y de ahorro de energía, que
        además aporten estética tanto en interiores como en exteriores, para
        satisfacer las necesidades de cada cliente según sus requerimientos
        y expectativas.
      </p>
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-black">
      Nuestros proveedores
    </h3>
    <p class="mt-2 text-slate-700">
      Trabajamos con proveedores líderes del mercado:
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      {
        providers.map((provider) => (
          <span class="rounded-full border border-royal-200 bg-white px-4 py-2 text-sm font-semibold tracking-wide text-black shadow-sm">
            {provider}
          </span>
        ))
      }
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-black">
      Ventajas competitivas
    </h3>
    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
      {
        advantages.map((advantage, i) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-md transition hover:-translate-y-1 hover:shadow-xl">
            <div class="h-1 w-10 rounded-full bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
            <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-brand-green-700">
              0{i + 1}
            </p>
            <h4 class="mt-1 text-xl font-semibold text-black">
              {advantage.title}
            </h4>
            <p class="mt-2 text-slate-700">{advantage.text}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-14 text-2xl font-bold tracking-tight text-black">
      Áreas de iluminación
    </h3>
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        areas.map((area) => (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-md">
            <div class="mb-4 h-1 w-10 rounded-full bg-brand-green-400"></div>
            <p class="text-lg font-semibold text-black">{area}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-slate-800">
      Conoce más de Ilumexa en video:
      <a
        href="https://youtu.be/eVwipVw4YxI"
        class="font-semibold text-brand-green-700 hover:underline"
      >
        Ver video en YouTube
      </a>.
    </p>
  </section>

  <!-- Productos (antes /products): 12 categorías del menú oficial -->
  <section id="productos" class="border-y border-royal-100 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        02 · Catálogo
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-black md:text-4xl">
        Nuestros productos
      </h2>
      <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <p class="mt-4 max-w-2xl text-lg text-slate-700">
        Categorías de productos de Ilumexa, según el menú del sitio oficial.
      </p>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          categories.map((category, i) => (
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl">
              <div class="h-1.5 bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
              <div class="p-8">
                <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 ring-1 ring-royal-100">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 18h6M10 21h4M12 3a6 6 0 00-3.3 11c.6.5 1.3 1.1 1.3 2h4c0-.9.7-1.5 1.3-2A6 6 0 0012 3z" />
                  </svg>
                </span>
                <p class="text-sm font-semibold uppercase tracking-widest text-brand-green-700">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-1 text-xl font-semibold text-black">
                  {category.name}
                </h3>
                <p class="mt-2 text-slate-700">{category.description}</p>
                <a
                  href="#contacto"
                  class="mt-5 inline-block rounded-full bg-brand-green-400 px-5 py-2 text-sm font-semibold text-black shadow-sm transition hover:bg-brand-green-300"
                >
                  Más información
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border border-brand-green-200 bg-brand-green-50 p-6">
        <p class="text-slate-800">
          Las fichas técnicas detalladas están pendientes: las páginas de
          producto del sitio oficial no cargan (404). Para el catálogo
          completo, contáctanos.
        </p>
      </div>
    </div>
  </section>

  <!-- Servicios (antes /services): los 2 servicios verificados -->
  <section id="servicios" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
      03 · Lo que hacemos por ti
    </p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-black md:text-4xl">
      Nuestros servicios
    </h2>
    <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
    <p class="mt-4 max-w-2xl text-lg text-slate-700">
      Servicios de Ilumexa, según el menú del sitio oficial.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        services.map((service, i) => (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl">
            <div class="h-1.5 bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
            <div class="p-8">
              {i === 0 ? (
                <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 ring-1 ring-royal-100">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                  </svg>
                </span>
              ) : (
                <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 ring-1 ring-royal-100">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                  </svg>
                </span>
              )}
              <p class="text-sm font-semibold uppercase tracking-widest text-brand-green-700">
                0{i + 1}
              </p>
              <h3 class="mt-1 text-2xl font-semibold text-black">
                {service.name}
              </h3>
              <p class="mt-3 text-lg text-slate-700">{service.description}</p>
              <a
                href="#contacto"
                class="mt-6 inline-block rounded-full bg-brand-green-400 px-5 py-2 text-sm font-semibold text-black shadow-sm transition hover:bg-brand-green-300"
              >
                Más información
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-brand-green-200 bg-brand-green-50 p-6">
      <p class="text-slate-800">
        El detalle de los servicios está pendiente de verificar: las páginas
        de servicios del sitio oficial no cargan (404).
      </p>
    </div>
  </section>

  <!-- Llamada a la acción: fondo verde claro, textos oscuros y botón
       verde claro con el texto en negro. -->
  <section class="bg-brand-green-50 px-4 py-20 text-center sm:px-6 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-black md:text-4xl">
        Ilumina tus proyectos con nosotros
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-700">
        Contáctanos para recibir asesoría personalizada en iluminación
        eficiente y moderna.
      </p>
      <a
        href="#contacto"
        class="mt-8 inline-block rounded-full bg-brand-green-400 px-8 py-3 font-semibold text-black shadow-lg transition hover:bg-brand-green-300"
      >
        Contáctanos
      </a>
    </div>
  </section>

  <!-- Contacto (antes /contact): datos y formulario mailto -->
  <section id="contacto" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
