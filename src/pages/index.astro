---
import Layout from '../layouts/Layout.astro';

// Base del sitio (v15): en GitHub Pages el sitio vive en /ilumexa/, no en
// la raíz, así que las imágenes usan import.meta.env.BASE_URL para que
// las rutas salgan con /ilumexa/ delante. En local es '/'.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Contenido verificado del sitio oficial (iluminandomexico.com.mx).
// Landing de una sola página (2026-11-07): todo el contenido de las
// antiguas páginas Acerca de, Productos, Servicios y Contacto vive aquí
// en secciones con ancla; el header ya no redirecciona a otras páginas.
// Todos los textos de estas secciones son negros u oscuros sobre fondos
// claros (2026-11-07, a petición de Patron): no queda texto blanco
// fuera del hero, donde va sobre la tarjeta oscura de la foto, y de las
// bandas con degradado azul rey (cifras y llamada a la acción, v11).
// v11 (2026-11-07): rediseño con estructura de landing gratuita
// AstroWind (MIT: hero, logos, features, steps, stats, CTA) adaptada a
// Ilumexa con solo contenido verificado; el carrusel de marcas NO se toca.

const categories = [
  {
    name: 'Alumbrado Público',
    description: 'Soluciones de iluminación para alumbrado público.',
  },
  {
    name: 'Alumbrado Exterior',
    description: 'Iluminación para espacios exteriores.',
  },
  {
    name: 'Iluminación LED',
    description: 'Productos de iluminación LED.',
  },
  {
    name: 'Luminario',
    description: 'Luminarios para distintos espacios y usos.',
  },
  {
    name: 'Postes',
    description: 'Postes para alumbrado.',
  },
  {
    name: 'Alumbrado Decorativo',
    description: 'Iluminación decorativa para distintos espacios.',
  },
  {
    name: 'Alumbrado Industrial',
    description: 'Iluminación para espacios industriales.',
  },
  {
    name: 'Postes - Fichas Técnicas',
    description: 'Fichas técnicas de postes. Detalle pendiente de verificar.',
  },
  {
    name: 'Exterior Decorativo',
    description: 'Iluminación decorativa para exteriores.',
  },
  {
    name: 'Interior Decorativo',
    description: 'Iluminación decorativa para interiores.',
  },
  {
    name: 'Mobiliario Decorativo',
    description: 'Mobiliario decorativo con iluminación.',
  },
  {
    name: 'Accesorios y Bases de Concreto',
    description:
      'Accesorios y bases de concreto para instalaciones de alumbrado.',
  },
];

const services = [
  {
    name: 'Mantenimiento e Instalación',
    description: 'Servicio de mantenimiento e instalación de alumbrado.',
  },
  {
    name: 'Asesoría de Proyectos',
    description: 'Asesoramiento en el desarrollo de sus proyectos.',
  },
];
---

<Layout title="Iluminando México">
  <!-- Hero principal: slider de una sola imagen.
       Foto: carretera con farolas encendidas de noche entre la niebla,
       de Darya Grey_Owl en Pexels (licencia gratuita), 2400x1600 px.
       Sustituye a la foto del sitio oficial (images/4a.png, 500x250 px),
       que se veía pixelada a todo el ancho. Es el único slide: no se
       inventaron más fotos ni hay rotación automática. Los textos van
       dentro de una tarjeta azul rey semitransparente con desenfoque,
       en blanco sobre la tarjeta oscura. Animación Ken Burns lenta sobre
       la foto y entrada escalonada de los textos (v11). -->
  <section
    id="inicio"
    class="relative w-full overflow-hidden"
    role="region"
    aria-roledescription="carrusel"
    aria-label="Ilumexa - Iluminando México"
  >
    <div class="relative h-[88vh] min-h-[560px] w-full md:h-[92vh]">
      <!-- Foto del hero con parallax (v13): el fondo queda fijo al hacer
           scroll en escritorio y el contenido se desliza encima. En
           táctil y pantallas pequeñas el fondo se mueve normal (ver
           global.css). -->
      <div class="parallax absolute inset-0 bg-cover bg-center" style={`background-image: url(${base}images/calle-iluminada.jpg)`} role="img" aria-label="Carretera iluminada de noche con farolas encendidas entre la niebla"></div>
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-r from-royal-950/70 via-royal-950/40 to-royal-950/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-royal-950/70 via-transparent to-transparent"></div>
        <!-- Brillos decorativos de la paleta -->
        <div class="absolute -right-20 -top-20 h-96 w-96 rounded-full bg-brand-green-400/20 blur-3xl"></div>
        <div class="absolute -bottom-24 -left-16 h-80 w-80 rounded-full bg-royal-500/30 blur-3xl"></div>
      </div>
      <div class="relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center px-4 text-center sm:px-6">
        <!-- Tarjeta oscura como en la v11 (Patron: ese hero estaba
             perfecto, solo le faltaba el parallax). Entrada escalonada
             con fade-up. -->
        <div class="max-w-2xl animate-fade-up rounded-3xl bg-royal-950/60 p-6 shadow-2xl backdrop-blur-md sm:p-10" style="animation-delay: 100ms">
          <p class="mx-auto mb-5 inline-block w-fit rounded-full border border-brand-green-300/50 bg-white/10 px-4 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-300">
            Iluminando a México e Innovando
          </p>
          <h1 class="max-w-2xl bg-gradient-to-r from-white via-white to-brand-green-300 bg-clip-text text-6xl font-extrabold leading-tight tracking-tight text-transparent md:text-7xl">
            Ilumexa
          </h1>
          <p class="mx-auto mt-5 max-w-2xl animate-fade-up text-lg leading-relaxed text-white md:text-xl" style="animation-delay: 250ms">
            Soluciones de iluminación pública, industrial, residencial y
            decorativa con marcas líderes.
          </p>
          <div class="mt-8 flex animate-fade-up flex-col justify-center gap-3 sm:flex-row" style="animation-delay: 400ms">
            <a
              href="#productos"
              class="rounded-full bg-white px-7 py-3 text-center font-semibold text-royal-800 shadow-xl transition hover:scale-[1.03] hover:bg-brand-green-100 active:scale-95"
            >
              Ver productos
            </a>
            <a
              href="#contacto"
              class="rounded-full border border-white/60 px-7 py-3 text-center font-semibold text-white transition hover:scale-[1.03] hover:bg-white/10 active:scale-95"
            >
              Contáctanos
            </a>
          </div>
        </div>
        <!-- Ventajas en el hero: afirmaciones verificadas del sitio oficial -->
        <div class="mt-6 flex animate-fade-up flex-wrap items-center justify-center gap-2.5" style="animation-delay: 550ms">
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
            Asesoría de proyectos
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
            </svg>
            Ahorro de energía
          </span>
          <span class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-white ring-1 ring-white/25 backdrop-blur">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 text-brand-green-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Marcas líderes
          </span>
        </div>
      </div>
      <!-- Indicador para deslizar: invita a bajar a las secciones -->
      <div class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1 text-white/80" aria-hidden="true">
        <span class="text-[11px] font-semibold uppercase tracking-[0.2em]">Desliza</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 animate-bounce">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
      <!-- Crédito de la foto del hero -->
      <p class="absolute bottom-5 right-4 z-10 hidden text-[11px] text-white/70 sm:block">
        Foto:
        <a href="https://www.pexels.com/photo/lighted-street-lights-between-a-highway-12348285/" class="underline hover:text-white" target="_blank" rel="noopener">Darya Grey_Owl / Pexels</a>
      </p>
    </div>
  </section>

  <!-- Carrusel de logos (duplicado: la segunda copia lleva aria-hidden
       para que la animación animate-scroll, que desplaza -50%, gire sin
       salto. No se cambió el orden ni las imágenes de la primera lista.
       Gira siempre: sin pausa al pasar el mouse, a petición de Patron.
       Fondo blanco (v13, a petición de Patron: así estaba bien). El
       parallax va en el hero, no aquí. El carrusel en sí no se tocó.) -->
  <section class="border-b border-slate-200 bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="mb-2 text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        Con el respaldo de
      </p>
      <h2 class="text-center text-3xl font-bold tracking-tight text-black">
        Marcas aliadas
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <div class="relative mt-10 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
        <div class="flex w-max animate-scroll">
          <div class="flex items-center space-x-12 pr-12">
            <img src={base + "images/tork.png"} alt="Tork" class="h-16" />
            <img src={base + "images/osram.png"} alt="OSRAM" class="h-16" />
            <img src={base + "images/forlexa.jpg"} alt="forlexa" class="h-16" />
            <img src={base + "images/philips.png"} alt="Philips" class="h-16" />
            <img src={base + "images/tecnolight.png"} alt="Tecno Light" class="h-16" />
            <img src={base + "images/amg.png"} alt="AMG" class="h-16" />
            <img src={base + "images/forlighting.png"} alt="Forlighting" class="h-16" />
            <img src={base + "images/luma.jpg"} alt="Luma" class="h-16" />
            <img src={base + "images/lumicom.png"} alt="Lumicom" class="h-16" />
            <img src={base + "images/magg.png"} alt="MAGG" class="h-16" />
            <img src={base + "images/sola-basic.png"} alt="Sola Basic" class="h-16" />
          </div>
          <div class="flex items-center space-x-12 pr-12" aria-hidden="true">
            <img src={base + "images/tork.png"} alt="" class="h-16" />
            <img src={base + "images/osram.png"} alt="" class="h-16" />
            <img src={base + "images/forlexa.jpg"} alt="" class="h-16" />
            <img src={base + "images/philips.png"} alt="" class="h-16" />
            <img src={base + "images/tecnolight.png"} alt="" class="h-16" />
            <img src={base + "images/amg.png"} alt="" class="h-16" />
            <img src={base + "images/forlighting.png"} alt="" class="h-16" />
            <img src={base + "images/luma.jpg"} alt="" class="h-16" />
            <img src={base + "images/lumicom.png"} alt="" class="h-16" />
            <img src={base + "images/magg.png"} alt="" class="h-16" />
            <img src={base + "images/sola-basic.png"} alt="" class="h-16" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Banda de cifras: solo números verificados del sitio oficial
       (12 categorías del menú, 2 servicios, 10 proveedores). Fondo azul
       visible (royal-200, v13) con textos oscuros. -->
  <section class="border-b border-royal-200 bg-royal-200">
    <div class="reveal mx-auto grid max-w-7xl grid-cols-1 divide-y divide-royal-300 px-4 py-14 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6">
      <div class="py-6 text-center sm:py-2">
        <p class="text-5xl font-extrabold tracking-tight text-royal-800 md:text-6xl">12</p>
        <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-brand-green-700">Categorías de productos</p>
      </div>
      <div class="py-6 text-center sm:py-2">
        <p class="text-5xl font-extrabold tracking-tight text-royal-800 md:text-6xl">2</p>
        <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-brand-green-700">Servicios especializados</p>
      </div>
      <div class="py-6 text-center sm:py-2">
        <p class="text-5xl font-extrabold tracking-tight text-royal-800 md:text-6xl">10</p>
        <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-brand-green-700">Marcas líderes</p>
      </div>
    </div>
  </section>

  <!-- Video de Ilumexa: banda blanca sobre el fondo azul claro -->
  <section class="border-b border-royal-100 bg-white">
    <div class="reveal mx-auto max-w-4xl px-4 py-20 sm:px-6 md:py-24">
      <p class="mb-2 text-center text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        Conoce Ilumexa
      </p>
      <h2 class="text-center text-3xl font-bold tracking-tight text-black md:text-4xl">
        Ilumexa en video
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <div class="mt-8 overflow-hidden rounded-3xl shadow-2xl ring-1 ring-slate-200">
        <iframe
          src="https://www.youtube.com/embed/eVwipVw4YxI"
          title="Video de Ilumexa"
          class="aspect-video w-full"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>


  <!-- Nosotros (antes /about): textos en negro sobre fondo claro.
       En escritorio, dos columnas: texto a la izquierda y la segunda
       foto (avenida de noche, Vova Kras / Pexels, 2400x1800) a la derecha,
       con una tarjeta flotante con el dato verificado de proveedores. -->
  <section id="nosotros" class="bg-royal-300">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <div class="reveal grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
          ¿Quiénes somos?
        </p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold tracking-tight text-black md:text-4xl">
          Iluminación con calidad, durabilidad y ahorro de energía
        </h2>
        <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>

        <div class="mt-8 max-w-3xl space-y-4 text-lg leading-relaxed text-slate-800">
          <p>
            Ilumexa es una empresa dedicada a la fabricación y comercialización
            de productos para alumbrado público, industrial, residencial y
            decorativo, así como a la comercialización de accesorios eléctricos.
          </p>
          <p>
            Nuestro compromiso es brindar un servicio de calidad a un precio
            competitivo, con productos durables y de ahorro de energía, que
            además aporten estética tanto en interiores como en exteriores, para
            satisfacer las necesidades de cada cliente según sus requerimientos
            y expectativas.
          </p>
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-3xl shadow-2xl ring-1 ring-slate-200">
          <img
            src={base + "images/avenida-noche.jpg"}
            alt="Avenida iluminada de noche con farolas y cielo oscuro"
            class="aspect-[4/3] w-full object-cover transition duration-700 hover:scale-105"
            loading="lazy"
          />
        </div>
        <p class="mt-2 text-right text-xs text-slate-500">
          Foto: <a href="https://www.pexels.com/photo/black-asphalt-road-during-night-time-10313578/" class="underline hover:text-black" target="_blank" rel="noopener">Vova Kras / Pexels</a>
        </p>
        <div class="absolute -bottom-6 left-4 flex animate-float-slow items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow-xl ring-1 ring-slate-200 sm:left-8">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-green-100 text-brand-green-700">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
          <span>
            <span class="block text-sm font-semibold text-black">Proveedores líderes</span>
            <span class="block text-xs text-slate-600">del mercado</span>
          </span>
        </div>
      </div>
    </div>
    </div>

  </section>

  <!-- Productos (antes /products): 12 categorías del menú oficial -->
  <section id="productos" class="border-y border-royal-100 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <div class="reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
          Catálogo
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-black md:text-4xl">
          Nuestros productos
        </h2>
        <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      </div>

      <div class="reveal mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        {
          categories.map((category, i) => (
            <div
              class="reveal group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md transition duration-300 hover:-translate-y-2 hover:shadow-2xl"
              style={`transition-delay: ${Math.min(i * 60, 480)}ms`}
            >
              <div class="h-1.5 bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
              <div class="p-8">
                <span class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-royal-50 text-royal-700 ring-1 ring-royal-100 transition duration-300 group-hover:bg-royal-700 group-hover:text-brand-green-300 group-hover:ring-royal-700">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 18h6M10 21h4M12 3a6 6 0 00-3.3 11c.6.5 1.3 1.1 1.3 2h4c0-.9.7-1.5 1.3-2A6 6 0 0012 3z" />
                  </svg>
                </span>
                <h3 class="mt-1 text-xl font-semibold text-black">
                  {category.name}
                </h3>
                <p class="mt-2 text-slate-700">{category.description}</p>
                <a
                  href="#contacto"
                  class="mt-5 inline-block rounded-full bg-brand-green-400 px-5 py-2 text-sm font-semibold text-black shadow-sm transition hover:bg-brand-green-300"
                >
                  Más información
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos (pasos al estilo AstroWind): los 3 pasos salen
       de los 2 servicios verificados (Asesoría de Proyectos y
       Mantenimiento e Instalación), sin inventar nada nuevo. Fondo azul
       (v12): alterna con las secciones blancas. -->
  <section class="bg-royal-300">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <div class="reveal text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-700">
        Cómo trabajamos
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-black md:text-4xl">
        De tu proyecto a la luz encendida
      </h2>
      <div class="mx-auto mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
    </div>

    <div class="relative mt-14 grid grid-cols-1 gap-10 md:grid-cols-3">
      <div class="absolute left-0 right-0 top-7 hidden border-t-2 border-dashed border-royal-600 md:block" aria-hidden="true"></div>
      {
        [
          { title: 'Asesoría de proyectos', text: 'Asesoramiento en el desarrollo de sus proyectos.' },
          { title: 'Instalación', text: 'Instalación de alumbrado público, industrial, residencial y decorativo.' },
          { title: 'Mantenimiento', text: 'Garantía de bajos costos de mantenimiento.' },
        ].map((step, i) => (
          <div
            class="reveal relative text-center"
            style={`transition-delay: ${i * 120}ms`}
          >
            <div class="relative z-10 mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white text-royal-700 shadow-lg ring-4 ring-brand-green-300">
              {i === 0 ? (
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-7 w-7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm3.75 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                </svg>
