          Al enviar, se abrirá tu correo con el mensaje ya redactado para Ilumexa.
        </p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="mb-2 block font-semibold text-black">Nombre</label>
            <input id="name" type="text" placeholder="Tu nombre"
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200" />
          </div>
          <div>
            <label for="email" class="mb-2 block font-semibold text-black">Correo electrónico</label>
            <input id="email" type="email" placeholder="tu@email.com"
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200" />
          </div>
          <div>
            <label for="message" class="mb-2 block font-semibold text-black">Mensaje</label>
            <textarea id="message" rows="4" placeholder="Escribe tu mensaje..."
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200"></textarea>
          </div>
          <button type="submit"
            class="w-full rounded-full bg-brand-green-400 px-4 py-3 font-semibold text-black shadow-md transition hover:bg-brand-green-300">
            Enviar
          </button>
        </form>

        <script>
          const form = document.getElementById('contact-form');
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const message = document.getElementById('message').value.trim();
            const subject = encodeURIComponent(`Contacto Ilumexa - ${name}`);
            const body = encodeURIComponent(
              `Nombre: ${name}\nCorreo: ${email}\n\n${message}`
            );
            window.location.href =
              `mailto:gop.ilumex@gmail.com?cc=gop_ilumex@hotmail.com&subject=${subject}&body=${body}`;
          });
        </script>
