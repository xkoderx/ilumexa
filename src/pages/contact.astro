---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto">
  <h2 class="text-3xl font-bold mb-6">Contáctanos</h2>

  <div class="max-w-lg mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 mb-8">
    <h3 class="text-xl font-semibold mb-4">Ubicación</h3>
    <p class="mb-4">
      Raymundo Montoya Mz. 22 Lt. 7, Col. Benito Juárez, C.P. 08930,
      Iztacalco, México D.F.
    </p>
    <h3 class="text-xl font-semibold mb-4">Contacto</h3>
    <ul class="list-disc list-inside mb-4 space-y-1">
      <li>Guillermina Osorno</li>
      <li>Efraín Quintero</li>
    </ul>
    <h3 class="text-xl font-semibold mb-4">Correos</h3>
    <ul class="list-disc list-inside space-y-1">
      <li>
        <a
          href="mailto:gop_ilumex@hotmail.com"
          class="text-blue-600 hover:underline"
        >
          gop_ilumex@hotmail.com
        </a>
      </li>
      <li>
        <a
          href="mailto:gop.ilumex@gmail.com"
          class="text-blue-600 hover:underline"
        >
          gop.ilumex@gmail.com
        </a>
      </li>
    </ul>
  </div>

  <p class="max-w-lg mx-auto mb-4 text-gray-700 dark:text-gray-300">
    El formulario de abajo aún no envía mensajes: todavía no tiene backend.
    Para contactar a Ilumexa, usa los correos o la dirección de arriba.
  </p>

  <form class="max-w-lg mx-auto bg-white dark:bg-gray-800 shadow-md rounded-lg p-6 space-y-4">
    <div>
      <label for="name" class="block mb-2 font-semibold">Nombre</label>
      <input id="name" type="text" placeholder="Tu nombre"
        class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600" />
    </div>
    <div>
      <label for="email" class="block mb-2 font-semibold">Correo electrónico</label>
      <input id="email" type="email" placeholder="tu@email.com"
        class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600" />
    </div>
    <div>
      <label for="message" class="block mb-2 font-semibold">Mensaje</label>
      <textarea id="message" rows="4" placeholder="Escribe tu mensaje..."
        class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600"></textarea>
    </div>
    <button type="submit"
      class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
      Enviar
    </button>
  </form>
</Layout>
