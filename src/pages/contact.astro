---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <!-- Banda de encabezado: texto blanco solo sobre degradado azul rey -->
    <div class="rounded-3xl bg-gradient-to-r from-royal-900 via-royal-800 to-royal-700 px-6 py-10 text-white shadow-lg sm:px-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-300">
        Escríbenos
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        Contáctanos
      </h2>
      <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <p class="mt-4 max-w-2xl text-lg text-royal-100">
        Cuéntanos tu proyecto y te asesoramos en iluminación eficiente y moderna.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-5">
      <div class="rounded-2xl bg-royal-900 p-8 text-white shadow-lg lg:col-span-2">
        <h3 class="text-xl font-semibold">Ubicación</h3>
        <p class="mt-3 leading-relaxed text-royal-100">
          Raymundo Montoya Mz. 22 Lt. 7, Col. Benito Juárez, C.P. 08930,
          Iztacalco, México D.F.
        </p>
        <h3 class="mt-8 text-xl font-semibold">Contacto</h3>
        <ul class="mt-3 list-disc list-inside space-y-1 text-royal-100">
          <li>Guillermina Osorno</li>
          <li>Efraín Quintero</li>
        </ul>
        <h3 class="mt-8 text-xl font-semibold">Correos</h3>
        <ul class="mt-3 space-y-1">
          <li>
            <a
              href="mailto:gop_ilumex@hotmail.com"
              class="font-medium text-brand-green-300 hover:underline"
            >
              gop_ilumex@hotmail.com
            </a>
          </li>
          <li>
            <a
              href="mailto:gop.ilumex@gmail.com"
              class="font-medium text-brand-green-300 hover:underline"
            >
              gop.ilumex@gmail.com
            </a>
          </li>
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:col-span-3">
        <p class="mb-6 text-slate-600 dark:text-slate-400">
          Al enviar, se abrirá tu correo con el mensaje ya redactado para Ilumexa.
        </p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block mb-2 font-semibold text-royal-950 dark:text-white">Nombre</label>
            <input id="name" type="text" placeholder="Tu nombre"
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200 dark:border-slate-700 dark:bg-slate-800" />
          </div>
          <div>
            <label for="email" class="block mb-2 font-semibold text-royal-950 dark:text-white">Correo electrónico</label>
            <input id="email" type="email" placeholder="tu@email.com"
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200 dark:border-slate-700 dark:bg-slate-800" />
          </div>
          <div>
            <label for="message" class="block mb-2 font-semibold text-royal-950 dark:text-white">Mensaje</label>
            <textarea id="message" rows="4" placeholder="Escribe tu mensaje..."
              class="w-full rounded-xl border border-slate-300 px-4 py-2.5 transition focus:border-royal-500 focus:outline-none focus:ring-2 focus:ring-royal-200 dark:border-slate-700 dark:bg-slate-800"></textarea>
          </div>
          <button type="submit"
            class="w-full rounded-full bg-royal-700 px-4 py-3 font-semibold text-white shadow-md transition hover:bg-royal-800">
            Enviar
          </button>
        </form>

        <script>
          const form = document.getElementById('contact-form');
          form.addEventListener('submit', (event) => {
            event.preventDefault();
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const message = document.getElementById('message').value.trim();
            const subject = encodeURIComponent(`Contacto Ilumexa - ${name}`);
            const body = encodeURIComponent(
              `Nombre: ${name}\nCorreo: ${email}\n\n${message}`
            );
            window.location.href =
              `mailto:gop.ilumex@gmail.com?cc=gop_ilumex@hotmail.com&subject=${subject}&body=${body}`;
          });
        </script>
      </div>
    </div>
  </div>
</Layout>
