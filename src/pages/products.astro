---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: 'Alumbrado Público',
    description:
      'Soluciones de iluminación para alumbrado público.',
  },
  {
    name: 'Alumbrado Exterior',
    description:
      'Iluminación para espacios exteriores.',
  },
  {
    name: 'Iluminación LED',
    description:
      'Productos de iluminación LED.',
  },
  {
    name: 'Luminario',
    description:
      'Luminarios para distintos espacios y usos.',
  },
  {
    name: 'Postes',
    description:
      'Postes para alumbrado.',
  },
  {
    name: 'Alumbrado Decorativo',
    description:
      'Iluminación decorativa para distintos espacios.',
  },
  {
    name: 'Alumbrado Industrial',
    description:
      'Iluminación para espacios industriales.',
  },
  {
    name: 'Postes - Fichas Técnicas',
    description:
      'Fichas técnicas de postes. Detalle pendiente de verificar.',
  },
  {
    name: 'Exterior Decorativo',
    description:
      'Iluminación decorativa para exteriores.',
  },
  {
    name: 'Interior Decorativo',
    description:
      'Iluminación decorativa para interiores.',
  },
  {
    name: 'Mobiliario Decorativo',
    description:
      'Mobiliario decorativo con iluminación.',
  },
  {
    name: 'Accesorios y Bases de Concreto',
    description:
      'Accesorios y bases de concreto para instalaciones de alumbrado.',
  },
];
---

<Layout title="Productos">
  <h2 class="text-3xl font-bold mb-6">Nuestros productos</h2>
  <p class="mb-6">
    Categorías de productos de Ilumexa, según el menú del sitio oficial.
  </p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      categories.map((category) => (
        <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-4">
          <h3 class="text-xl font-semibold mb-2">{category.name}</h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            {category.description}
          </p>
          <a
            href="/contact"
            class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
          >
            Más información
          </a>
        </div>
      ))
    }
  </div>
  <p class="mt-8 text-gray-700 dark:text-gray-300">
    Las fichas técnicas detalladas están pendientes: las páginas de producto
    del sitio oficial no cargan (404). Para el catálogo completo, contáctanos.
  </p>
</Layout>
