---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Productos">
  <h2 class="text-3xl font-bold mb-6">Nuestros productos</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Tarjeta 1 -->
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-4">
      <img src="/images/luminaria-led.jpg" alt="Luminaria LED" class="rounded mb-4" />
      <h3 class="text-xl font-semibold mb-2">Luminaria LED</h3>
      <p class="text-gray-700 dark:text-gray-300 mb-4">
        Iluminación eficiente para espacios públicos y privados, con ahorro de energía garantizado.
      </p>
      <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        Más información
      </button>
    </div>

    <!-- Tarjeta 2 -->
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-4">
      <img src="/images/industrial-light.jpg" alt="Iluminación Industrial" class="rounded mb-4" />
      <h3 class="text-xl font-semibold mb-2">Iluminación Industrial</h3>
      <p class="text-gray-700 dark:text-gray-300 mb-4">
        Diseñada para fábricas y almacenes, con máxima durabilidad y potencia lumínica.
      </p>
      <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        Más información
      </button>
    </div>

    <!-- Tarjeta 3 -->
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-4">
      <img src="/images/decor-light.jpg" alt="Iluminación Decorativa" class="rounded mb-4" />
      <h3 class="text-xl font-semibold mb-2">Iluminación Decorativa</h3>
      <p class="text-gray-700 dark:text-gray-300 mb-4">
        Dale estilo a tus espacios con lámparas y accesorios modernos y elegantes.
      </p>
      <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        Más información
      </button>
    </div>

  </div>
</Layout>
