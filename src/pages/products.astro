---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    name: 'Alumbrado Público',
    description:
      'Soluciones de iluminación para alumbrado público.',
  },
  {
    name: 'Alumbrado Exterior',
    description:
      'Iluminación para espacios exteriores.',
  },
  {
    name: 'Iluminación LED',
    description:
      'Productos de iluminación LED.',
  },
  {
    name: 'Luminario',
    description:
      'Luminarios para distintos espacios y usos.',
  },
  {
    name: 'Postes',
    description:
      'Postes para alumbrado.',
  },
  {
    name: 'Alumbrado Decorativo',
    description:
      'Iluminación decorativa para distintos espacios.',
  },
  {
    name: 'Alumbrado Industrial',
    description:
      'Iluminación para espacios industriales.',
  },
  {
    name: 'Postes - Fichas Técnicas',
    description:
      'Fichas técnicas de postes. Detalle pendiente de verificar.',
  },
  {
    name: 'Exterior Decorativo',
    description:
      'Iluminación decorativa para exteriores.',
  },
  {
    name: 'Interior Decorativo',
    description:
      'Iluminación decorativa para interiores.',
  },
  {
    name: 'Mobiliario Decorativo',
    description:
      'Mobiliario decorativo con iluminación.',
  },
  {
    name: 'Accesorios y Bases de Concreto',
    description:
      'Accesorios y bases de concreto para instalaciones de alumbrado.',
  },
];
---

<Layout title="Productos">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
    <!-- Banda de encabezado: texto blanco solo sobre degradado azul rey -->
    <div class="rounded-3xl bg-gradient-to-r from-royal-900 via-royal-800 to-royal-700 px-6 py-10 text-white shadow-lg sm:px-10">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-300">
        Catálogo
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">
        Nuestros productos
      </h2>
      <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
      <p class="mt-4 max-w-2xl text-lg text-royal-100">
        Categorías de productos de Ilumexa, según el menú del sitio oficial.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        categories.map((category, i) => (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div class="h-1.5 bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
            <div class="p-8">
              <p class="text-sm font-semibold uppercase tracking-widest text-brand-green-600 dark:text-brand-green-400">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="mt-1 text-xl font-semibold text-royal-950 dark:text-white">
                {category.name}
              </h3>
              <p class="mt-2 text-slate-600 dark:text-slate-400">
                {category.description}
              </p>
              <a
                href="/contact"
                class="mt-5 inline-block rounded-full bg-royal-700 px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-royal-800"
              >
                Más información
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-brand-green-200 bg-brand-green-50 p-6 dark:border-royal-800 dark:bg-royal-950/50">
      <p class="text-slate-700 dark:text-slate-300">
        Las fichas técnicas detalladas están pendientes: las páginas de
        producto del sitio oficial no cargan (404). Para el catálogo
        completo, contáctanos.
      </p>
    </div>
  </div>
</Layout>
