---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Mantenimiento e Instalación',
    description:
      'Servicio de mantenimiento e instalación de alumbrado.',
  },
  {
    name: 'Asesoría de Proyectos',
    description:
      'Asesoramiento en el desarrollo de sus proyectos.',
  },
];
---

<Layout title="Servicios">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-green-600 dark:text-brand-green-400">
      Lo que hacemos por ti
    </p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-royal-950 dark:text-white md:text-4xl">
      Nuestros servicios
    </h2>
    <div class="mt-3 h-1 w-16 rounded-full bg-brand-green-400"></div>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
      Servicios de Ilumexa, según el menú del sitio oficial.
    </p>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        services.map((service, i) => (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-800 dark:bg-slate-900">
            <div class="h-1.5 bg-gradient-to-r from-royal-700 to-brand-green-400"></div>
            <div class="p-8">
              <p class="text-sm font-semibold uppercase tracking-widest text-brand-green-600 dark:text-brand-green-400">
                0{i + 1}
              </p>
              <h3 class="mt-1 text-2xl font-semibold text-royal-950 dark:text-white">
                {service.name}
              </h3>
              <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
                {service.description}
              </p>
              <a
                href="/contact"
                class="mt-6 inline-block rounded-full bg-royal-700 px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-royal-800"
              >
                Más información
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-royal-200 bg-royal-50 p-6 dark:border-royal-800 dark:bg-royal-950/50">
      <p class="text-slate-700 dark:text-slate-300">
        El detalle de los servicios está pendiente de verificar: las páginas
        de servicios del sitio oficial no cargan (404).
      </p>
    </div>

    <div class="mt-10 rounded-2xl bg-gradient-to-r from-royal-900 to-royal-700 px-6 py-10 text-center text-white shadow-lg">
      <h3 class="text-2xl font-bold">¿Tienes un proyecto en mente?</h3>
      <p class="mx-auto mt-2 max-w-xl text-royal-100">
        Contáctanos para recibir asesoría personalizada en iluminación
        eficiente y moderna.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block rounded-full bg-brand-green-400 px-7 py-3 font-semibold text-royal-950 shadow transition hover:bg-brand-green-300"
      >
        Contáctanos
      </a>
    </div>
  </div>
</Layout>
